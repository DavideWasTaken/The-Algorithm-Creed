# Reference only: main.py does not automatically load .env files.
# Export variables in your shell or configure your deployment environment.
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ALGOCREED_MODE=hotkey
ALGOCREED_TRIGGER_KEY=a
ALGOCREED_DEFAULT_LANG=it
ALGOCREED_SKIP_LANG_SELECTION=0
ALGOCREED_GPT_MODEL=openai/gpt-oss-120b
ALGOCREED_GROQ_REASONING_EFFORT=low
ALGOCREED_GROQ_REASONING_FORMAT=hidden
ALGOCREED_STT_BACKEND=elevenlabs
ALGOCREED_TTS_PRIMARY=elevenlabs
ALGOCREED_VOSK_MODEL_IT=models/vosk-model-small-it
ALGOCREED_VOSK_MODEL_EN=models/vosk-model-small-en-us
# Optional: choose voices available in your account.
# ELEVENLABS_VOICE_IT=
# ELEVENLABS_VOICE_EN=
# Archive publishing requires an endpoint/token explicitly provisioned to you.
ALGOCREED_PUBLISH_ENABLED=0
ALGOCREED_INGEST_URL=
ALGOCREED_INGEST_TOKEN=
ALGOCREED_PUBLISH_MODEL=openai/gpt-oss-20b
ALGOCREED_PUBLISH_MAX_TOKENS=400
